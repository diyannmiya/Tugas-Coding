<!DOCTYPE html>
<html>
<head>
    <title>Log into Instagram - Tugas 3 HTML</title>

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background-color: #0b1014;
            color: white;
            font-family: Arial, sans-serif;
        }

        .container {
            display: flex;
            width: 100%;
            min-height: 100vh;
        }


        /* ================= BAGIAN KIRI ================= */

        .left {
            width: 57%;
            background-color: #0b1014;
        }

        .logo-area {
            width: 100%;
            height: 120px;
        }

        .logo-area img {
            width: 75px;
            margin-left: 20px;
            margin-top: 20px;
        }

        .left-content {
            width: 100%;
            text-align: center;
        }

        .left-content h1 {
            font-size: 30px;
            font-weight: normal;
            line-height: 1.3;
            margin: 0;
        }

        .pink {
            color: #e1306c;
        }

        .foto {
            margin-top: 30px;
        }

        .foto img {
            width: 400px;
            max-width: 90%;
        }


        /* ================= GARIS PEMBATAS ================= */

        .divider {
            width: 1px;
            background-color: #333333;
        }


        /* ================= BAGIAN KANAN ================= */

        .right {
            width: 43%;
            background-color: #202022;
            padding: 110px 55px;
        }

        .login-box {
            max-width: 560px;
            margin: auto;
        }

        h2 {
            font-size: 18px;
            margin-bottom: 35px;
        }

        input {
            width: 100%;
            height: 62px;
            margin-bottom: 12px;
            padding: 0 16px;

            background-color: #202022;
            border: 2px solid #555;
            border-radius: 15px;

            color: white;
            font-size: 15px;
        }

        input:focus {
            outline: none;
            border-color: #888;
        }

        .login {
            width: 100%;
            height: 50px;
            margin-top: 10px;

            border: none;
            border-radius: 25px;

            background-color: #1769c2;
            color: white;
            font-size: 15px;
            font-weight: bold;
        }

        .forgot {
            text-align: center;
            margin: 25px 0 65px;
            font-weight: bold;
        }

        .facebook {
            width: 100%;
            height: 50px;

            border: none;
            border-radius: 25px;

            background-color: #2a2a2d;
            color: white;
            font-size: 15px;
        }

        .facebook span {
            color: #1683db;
            font-weight: bold;
        }

        .create {
            width: 100%;
            height: 50px;
            margin-top: 12px;

            border: 2px solid #1683db;
            border-radius: 25px;

            background-color: transparent;
            color: #1683db;

            font-size: 15px;
            font-weight: bold;
        }

        .meta {
            text-align: center;
            margin-top: 30px;
            color: #ddd;
            font-size: 17px;
        }


        /* ================= AGAR BAGUS DI HP ================= */

        @media (max-width: 800px) {

            .container {
                display: block;
            }

            .left,
            .right {
                width: 100%;
            }

            .left {
                display: none;
            }

            .right {
                min-height: 100vh;
                padding: 80px 25px;
            }

        }

    </style>
</head>


<body>

    <div class="container">


        <!-- ================= BAGIAN KIRI ================= -->

        <div class="left">

            <!-- Logo Instagram -->
            <div class="logo-area">

                <img
                    src="https://static.cdninstagram.com/rsrc.php/yO/r/Ny6hrBVLYjl.webp"
                    alt="Instagram"
                >

            </div>


            <!-- Isi Bagian Kiri -->
            <div class="left-content">

                <!-- Tulisan -->
                <h1>
                    See everyday moments from your
                    <br>

                    <span class="pink">
                        close friends.
                    </span>
                </h1>


                <!-- Gambar Close Friends -->
                <div class="foto">

                    <img
                        src="https://static.cdninstagram.com/rsrc.php/yJ/r/53X3pk-t2Gn.webp"
                        alt="Close Friends"
                    >

                </div>

            </div>

        </div>


        <!-- ================= GARIS PEMBATAS ================= -->

        <div class="divider"></div>


        <!-- ================= BAGIAN KANAN ================= -->

        <div class="right">

            <div class="login-box">

                <h2>
                    Log into Instagram
                </h2>


                <!-- Username -->
                <input
                    type="text"
                    placeholder="Mobile number, username or email"
                >


                <!-- Password -->
                <input
                    type="password"
                    placeholder="Password"
                >


                <!-- Login -->
                <button class="login">
                    Log in
                </button>


                <!-- Forgot Password -->
                <p class="forgot">
                    Forgot password?
                </p>


                <!-- Facebook -->
                <button class="facebook">

                    <span>f</span>
                    &nbsp;
                    Log in with Facebook

                </button>


                <!-- Create Account -->
                <button class="create">
                    Create new account
                </button>


                <!-- Meta -->
                <p class="meta">
                    ∞ Meta
                </p>

            </div>

        </div>

    </div>

</body>
</html>
