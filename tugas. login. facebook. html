<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Meta Account - Demo</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: Arial, Helvetica, sans-serif;
        }

        body {
            background-color: white;
            color: #1c1e21;
        }

        .container {
            width: 100%;
            max-width: 850px;
            margin: auto;
            padding: 25px 35px 40px;
        }

        /* Tombol kembali */
        .back {
            font-size: 38px;
            color: #555;
            cursor: pointer;
            margin-bottom: 22px;
        }

        /* Logo Meta */
        .brand {
            display: flex;
            align-items: center;
            gap: 7px;
            margin-bottom: 20px;
        }

        .meta-logo {
            font-size: 40px;
            font-weight: bold;
            color: #1877f2;
            line-height: 1;
        }

        .meta-text {
            font-size: 25px;
            font-weight: bold;
            color: #1c1e21;
        }

        /* Judul */
        h1 {
            font-size: 30px;
            line-height: 1.2;
            margin-bottom: 8px;
        }

        .description {
            color: #555;
            font-size: 17px;
            line-height: 1.4;
            margin-bottom: 25px;
        }

        /* Label */
        label {
            display: block;
            font-size: 18px;
            font-weight: bold;
            margin-top: 20px;
            margin-bottom: 10px;
        }

        /* Input */
        input,
        select {
            width: 100%;
            height: 58px;
            padding: 0 20px;
            border: 1px solid #c9c9c9;
            border-radius: 14px;
            background-color: white;
            font-size: 17px;
            outline: none;
        }

        input:focus,
        select:focus {
            border: 2px solid #1877f2;
        }

        /* Nama */
        .name-box {
            display: flex;
            gap: 15px;
        }

        .name-box input {
            width: 50%;
        }

        /* Tanggal lahir */
        .birth-box {
            display: flex;
            gap: 15px;
        }

        .birth-box select {
            width: 33.33%;
        }

        /* Keterangan */
        .info {
            font-size: 15px;
            color: #555;
            line-height: 1.4;
            margin-top: 10px;
        }

        .info a {
            color: #1877f2;
            font-weight: bold;
            text-decoration: none;
        }

        /* Informasi demo */
        .demo-info {
            margin-top: 22px;
            padding: 12px;
            border-radius: 10px;
            background: #f0f2f5;
            color: #555;
            font-size: 14px;
            line-height: 1.4;
        }

        /* Terms */
        .terms {
            font-size: 15px;
            color: #555;
            line-height: 1.5;
            margin-top: 18px;
        }

        .terms a {
            color: #1877f2;
            font-weight: bold;
            text-decoration: none;
        }

        /* Tombol */
        button {
            width: 100%;
            height: 56px;
            border: none;
            border-radius: 30px;
            font-size: 17px;
            font-weight: bold;
            cursor: pointer;
        }

        .submit {
            background-color: #1877f2;
            color: white;
            margin-top: 25px;
        }

        .submit:hover {
            background-color: #166fe5;
        }

        .already {
            background-color: #f1f2f4;
            color: #333;
            margin-top: 15px;
        }

        .already:hover {
            background-color: #e4e6eb;
        }

        /* Tampilan HP */
        @media (max-width: 600px) {

            .container {
                padding: 20px;
            }

            h1 {
                font-size: 27px;
            }

            .description {
                font-size: 16px;
            }

            .name-box {
                gap: 10px;
            }

            .birth-box {
                gap: 8px;
            }

            input,
            select {
                height: 55px;
                padding: 0 14px;
                font-size: 15px;
            }

            .name-box input {
                width: 50%;
            }
        }
    </style>
</head>

<body>

    <div class="container">

        <!-- Tombol kembali -->
        <div class="back" onclick="history.back()">
            ‹
        </div>


        <!-- LOGO META -->
        <div class="brand">

            <span class="meta-logo">∞</span>

            <span class="meta-text">
                Meta
            </span>

        </div>


        <!-- JUDUL -->
        <h1>
            Get started with an account
        </h1>

        <p class="description">
            An account lets you access multiple technologies
            easily and securely.
        </p>


        <!-- NAMA -->
        <label>
            Name
        </label>

        <div class="name-box">

            <input
                type="text"
                placeholder="First name"
            >

            <input
                type="text"
                placeholder="Surname"
            >

        </div>


        <!-- TANGGAL LAHIR -->
        <label>
            Date of birth ⓘ
        </label>

        <div class="birth-box">

            <select>
                <option selected disabled>
                    Day
                </option>

                <option>1</option>
                <option>2</option>
                <option>3</option>
                <option>4</option>
                <option>5</option>
                <option>6</option>
                <option>7</option>
                <option>8</option>
                <option>9</option>
                <option>10</option>
                <option>11</option>
                <option>12</option>
                <option>13</option>
                <option>14</option>
                <option>15</option>
                <option>16</option>
                <option>17</option>
                <option>18</option>
                <option>19</option>
                <option>20</option>
                <option>21</option>
                <option>22</option>
                <option>23</option>
                <option>24</option>
                <option>25</option>
                <option>26</option>
                <option>27</option>
                <option>28</option>
                <option>29</option>
                <option>30</option>
                <option>31</option>
            </select>


            <select>
                <option selected disabled>
                    Month
                </option>

                <option>January</option>
                <option>February</option>
                <option>March</option>
                <option>April</option>
                <option>May</option>
                <option>June</option>
                <option>July</option>
                <option>August</option>
                <option>September</option>
                <option>October</option>
                <option>November</option>
                <option>December</option>
            </select>


            <select>
                <option selected disabled>
                    Year
                </option>

                <option>2010</option>
                <option>2011</option>
                <option>2012</option>
                <option>2013</option>
                <option>2014</option>
            </select>

        </div>


        <!-- GENDER -->
        <label>
            Gender ⓘ
        </label>

        <select>

            <option selected disabled>
                Select your gender
            </option>

            <option>Female</option>
            <option>Male</option>
            <option>Other</option>

        </select>


        <!-- EMAIL / NOMOR HP -->
        <label>
            Mobile number or email address
        </label>

        <input
            type="text"
            placeholder="Mobile number or email address"
            autocomplete="off"
        >

        <p class="info">
            You may receive notifications from us.
            <a href="#">
                Learn why we ask for your contact information
            </a>
        </p>


        <!-- PASSWORD -->
        <label>
            Password
        </label>

        <input
            type="password"
            placeholder="Password"
            autocomplete="new-password"
        >


        <!-- KETERANGAN DEMO -->
        <div class="demo-info">
            <b>Demo Project</b><br>
            Halaman ini dibuat untuk latihan HTML dan CSS.
            Data yang dimasukkan tidak dikirim atau disimpan
            ke server.
        </div>


        <!-- TERMS -->
        <p class="terms">
            By tapping Submit, you agree to this demo's
            <a href="#">Terms</a>,
            <a href="#">Privacy Policy</a> and
            <a href="#">Cookies Policy</a>.
        </p>


        <!-- SUBMIT -->
        <button
            class="submit"
            type="button"
            onclick="submitDemo()"
        >
            Submit
        </button>


        <!-- AKUN SUDAH ADA -->
        <button
            class="already"
            type="button"
            onclick="alreadyHaveAccount()"
        >
            I already have an account
        </button>

    </div>


    <!-- JAVASCRIPT -->
    <script>

        function submitDemo() {

            alert(
                "Ini hanya halaman demo untuk latihan HTML/CSS. " +
                "Data tidak dikirim ke server."
            );

        }


        function alreadyHaveAccount() {

            alert(
                "Tombol akun lama — fitur ini belum dibuat."
            );

        }

    </script>

</body>
</html>
